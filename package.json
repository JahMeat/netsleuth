{
  "name": "netsleuth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,party -c cyan,magenta \"next dev\" \"partykit dev\"",
    "dev:next": "next dev",
    "dev:party": "partykit dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "deploy:party": "partykit deploy",
    "dev:party:fast": "partykit dev --var ROUND_MS=20000 --var MEETING_MS=25000",
    "test:feed": "tsx scripts/feed-demo.mts",
    "test:game": "tsx scripts/game-test.mts"
  },
  "dependencies": {
    "next": "16.3.5",
    "partysocket": "^1.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "partykit": "^0.0.115",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
