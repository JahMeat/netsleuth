# Optional. Leave unset for the normal setup.
#
# PartyKit serves the site and the room server from one origin, so the client
# works out the socket host from the page URL and needs no configuration.
# Local dev is handled too: a page on localhost dials 127.0.0.1:1999.
#
# Set this only if you host the frontend somewhere else (Vercel, Netlify, ...)
# and point it at a separately deployed room server:
# NEXT_PUBLIC_PARTYKIT_HOST=netsleuth.<your-partykit-username>.partykit.dev
